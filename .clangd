CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -Wno-unused-function

---
If:
  PathMatch: test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch:
    - src/.*
    - bash_default/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch:
    - common/.*\.h
    - test/[^/]*\.c
CompileFlags:
  Add:
    - -I../src

---
If:
  PathMatch: common/scanner\.h
CompileFlags:
  Add:
    - -DBASH_EXTGLOB=1

---
If:
  PathMatch: test/scanner\.test\.c
CompileFlags:
  Add:
    - -DSCANNER_TEST_ENTRY="../src/scanner.c"

---
If:
  PathMatch:
    - src/scanner\.c
    - bash_default/src/scanner\.c
CompileFlags:
  Add:
    - -Wno-unused-function
