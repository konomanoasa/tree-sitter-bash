{
  "name": "@konomanoasa/tree-sitter-bash",
  "version": "0.1.0",
  "type": "module",
  "description": "Tree-sitter grammars for Bash.",
  "license": "MIT",
  "repository": "git+https://github.com/konomanoasa/tree-sitter-bash.git",
  "files": [
    "Cargo.toml",
    "bash_extglob/grammar.js",
    "bash_extglob/src/*.c",
    "bash_extglob/src/*.h",
    "bash_extglob/src/*.json",
    "bash_extglob/src/tree_sitter/*.h",
    "bash_extglob_noextquote/grammar.js",
    "bash_extglob_noextquote/src/*.c",
    "bash_extglob_noextquote/src/*.h",
    "bash_extglob_noextquote/src/*.json",
    "bash_extglob_noextquote/src/tree_sitter/*.h",
    "bash_noextquote/grammar.js",
    "bash_noextquote/src/*.c",
    "bash_noextquote/src/*.h",
    "bash_noextquote/src/*.json",
    "bash_noextquote/src/tree_sitter/*.h",
    "bindings/rust/*.rs",
    "common/*",
    "grammar.js",
    "queries/*.scm",
    "src/*.c",
    "src/*.h",
    "src/*.json",
    "src/tree_sitter/*.h",
    "test/bindings.test.rs",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run tree-sitter -- build-all",
    "check": "biome check . && tsc --noEmit",
    "check:queries": "npm run tree-sitter -- check-queries",
    "format": "biome format --write .",
    "generate": "npm run tree-sitter -- generate-all",
    "test": "npm run tree-sitter -- test-corpus --rebuild && node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:fuzz:corpus": "npm run tree-sitter -- fuzz-all --iterations 100 --edits 5",
    "test:highlights": "node --test test/highlight.test.js",
    "test:incremental": "node --test test/incremental.test.js",
    "test:performance": "node --test test/performance.test.js",
    "test:sanitize": "node scripts/check-c.js --sanitize",
    "test:scanner": "node scripts/check-c.js",
    "tree-sitter": "node scripts/tree-sitter.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.5.1",
    "tree-sitter-cli": "0.27.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
