{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bash_default",
      "title": "Bash (default options)",
      "scope": "source.bash_default",
      "path": ".",
      "file-types": ["bash", "bash_default"],
      "injection-regex": "^bash(_default)?$",
      "highlights": "queries/highlights.scm",
      "external-files": [
        "common/arithmetic.h",
        "common/input.h",
        "common/source.h",
        "common/scanner.h",
        "common/lexical-tokens.json",
        "src/lexical-tokens.h"
      ]
    },
    {
      "name": "bash_extglob",
      "title": "Bash (extglob enabled)",
      "scope": "source.bash_extglob",
      "path": "bash_extglob",
      "file-types": ["bash_extglob"],
      "injection-regex": "^bash_extglob$",
      "highlights": "queries/highlights.scm",
      "external-files": [
        "common/arithmetic.h",
        "common/input.h",
        "common/source.h",
        "common/scanner.h",
        "common/lexical-tokens.json",
        "bash_extglob/src/lexical-tokens.h",
        "src/parser.c",
        "src/tree_sitter/parser.h"
      ]
    }
  ],
  "metadata": {
    "version": "0.7.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for Bash.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-bash"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
